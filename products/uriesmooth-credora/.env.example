NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info

# Configure only through a local ignored .env file or a deployment secret manager.
# Never commit real credentials.
DATABASE_URL=
REDIS_URL=

# Provider credentials are added only after a provider is selected and sandbox access is approved.
VTU_PROVIDER_PRIMARY=
VTU_PROVIDER_SECONDARY=

# Use an explicit deployment-managed secret; do not generate a production key at startup.
APP_SECRET=
